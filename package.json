{
  "name": "nextjs-nav-guard",
  "version": "1.0.7",
  "description": "Prevent accidental navigation away from unsaved changes in Next.js App Router.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc --watch -p .",
    "check:packaging": "pnpm dlx @arethetypeswrong/cli --pack .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install"
  },
  "keywords": [
    "nextjs",
    "navigation",
    "guard",
    "unsaved-changes",
    "app-router",
    "route-guard"
  ],
  "author": "Brett Schneider <brett.c.schneider@gmail.com>",
  "license": "MIT",
  "homepage": "https://nextjs-nav-guard.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/br-schneider/nextjs-nav-guard.git"
  },
  "bugs": {
    "url": "https://github.com/br-schneider/nextjs-nav-guard/issues"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1",
  "peerDependencies": {
    "next": "^14 || ^15 || ^16",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "next": "^16.2.11",
    "playwright": "^1.61.0",
    "react": "^19.0.0",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": "^3.3.13",
      "postcss@8": "^8.5.15",
      "cross-spawn@7": "^7.0.6",
      "glob@10": "^10.5.0",
      "minimatch@9": "^9.0.9",
      "picomatch@2": "^2.3.2",
      "brace-expansion@2": "^2.1.2",
      "ws@8": "^8.21.0",
      "undici@7": "^7.28.0",
      "sharp": "^0.35.0",
      "@hono/node-server": "^2.0.5",
      "wrangler>esbuild": "0.28.1"
    }
  }
}
