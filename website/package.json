{
  "name": "nextjs-nav-guard-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i src/styles.css -o public/styles.css --watch",
    "dev": "tailwindcss -i src/styles.css -o public/styles.css && vite dev",
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "build": "npm run build:css && vite build",
    "build:node": "npm run build:css && vite build --config vite.config.node.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  }
}
